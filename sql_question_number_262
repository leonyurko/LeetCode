/*
Join Trips to Users twice (client and driver) and keep only trips where both
are unbanned and the date is within 2013-10-01 to 2013-10-03.
Per day, the cancellation rate is the average of a 0/1 flag marking trips
whose status is not 'completed', rounded to two decimals.
*/

SELECT t.request_at AS Day,
       ROUND(AVG(t.status <> 'completed'), 2) AS `Cancellation Rate`
FROM Trips t
JOIN Users c ON c.users_id = t.client_id AND c.banned = 'No'
JOIN Users d ON d.users_id = t.driver_id AND d.banned = 'No'
WHERE t.request_at BETWEEN '2013-10-01' AND '2013-10-03'
GROUP BY t.request_at;
